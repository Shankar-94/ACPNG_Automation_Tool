<Window x:Class="SimpleSapScraper.Frontend.Views.SuccessModal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Success"
        Height="380"
        Width="460"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True">

    <Border Background="#FFFFFF"
            CornerRadius="20"
            BorderBrush="#E2E8F0"
            BorderThickness="1"
            Padding="32">

        <Border.Effect>
            <DropShadowEffect BlurRadius="30"
                              ShadowDepth="0"
                              Opacity="0.25"
                              Color="#000000"/>
        </Border.Effect>

        <Grid>

            <!-- CLOSE BUTTON IN TOP-RIGHT -->
            <Button x:Name="CloseButton"
                    Width="30"
                    Height="30"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,-10,-10,0"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="CloseButton_Click">

                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="closeBorder"
                                Background="#F1F5F9"
                                CornerRadius="15"
                                Width="30"
                                Height="30">
                            <TextBlock Text="✕"
                                       Foreground="#64748B"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="closeBorder" Property="Background" Value="#FEE2E2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <StackPanel>

                <!-- ANIMATED CHECK CIRCLE -->
                <Border Width="84"
                        Height="84"
                        Background="#16A34A"
                        CornerRadius="42"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,20"
                        RenderTransformOrigin="0.5,0.5">

                    <Border.RenderTransform>
                        <ScaleTransform x:Name="CheckScale" ScaleX="0" ScaleY="0"/>
                    </Border.RenderTransform>

                    <Border.Effect>
                        <DropShadowEffect BlurRadius="20"
                                          ShadowDepth="0"
                                          Opacity="0.35"
                                          Color="#16A34A"/>
                    </Border.Effect>

                    <TextBlock Text="✓"
                               Foreground="White"
                               FontSize="46"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>

                <!-- TITLE -->
                <TextBlock x:Name="TitleTextBlock"
                           Text="Success!"
                           Foreground="#0F172A"
                           FontSize="26"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,10"/>

                <!-- MESSAGE -->
                <TextBlock x:Name="MessageTextBlock"
                           Text="Operation completed successfully."
                           Foreground="#475569"
                           FontSize="14"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           LineHeight="20"
                           Margin="0,0,0,24"/>

                <!-- OK BUTTON -->
                <Button x:Name="OkButton"
                        Content="OK"
                        Height="44"
                        Width="160"
                        HorizontalAlignment="Center"
                        Foreground="White"
                        Background="#2563EB"
                        BorderBrush="#2563EB"
                        BorderThickness="1"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Cursor="Hand"
                        Click="OkButton_Click">

                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="11">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

            </StackPanel>
        </Grid>
    </Border>

    <Window.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="CheckScale"
                                     Storyboard.TargetProperty="ScaleX"
                                     From="0" To="1"
                                     Duration="0:0:0.45">
                        <DoubleAnimation.EasingFunction>
                            <BackEase Amplitude="0.6" EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="CheckScale"
                                     Storyboard.TargetProperty="ScaleY"
                                     From="0" To="1"
                                     Duration="0:0:0.45">
                        <DoubleAnimation.EasingFunction>
                            <BackEase Amplitude="0.6" EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>
</Window>